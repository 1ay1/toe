prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: toe
Description: A GPU-accelerated terminal engine (core). Bring your own window.
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -ltoe
