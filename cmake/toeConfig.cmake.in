@PACKAGE_INIT@
# SPDX-License-Identifier: LGPL-2.0-or-later
#
# toeConfig.cmake — find_package(toe) entry point.
#
# toe exports a single target: toe::toe — the terminal ENGINE (VT parse, screen
# model, GL renderer). It has no window-system dependency; the host brings its
# own window and drives toe::Terminal. toe::core is provided as a back-compat
# alias.

include(CMakeFindDependencyMacro)

# toe's private link deps are recorded on the exported target as PkgConfig::*
# imported targets. A consumer must recreate those before the target file is
# included. Both are PRIVATE — no header of them leaks.
find_dependency(PkgConfig)
pkg_check_modules(PNG   REQUIRED IMPORTED_TARGET libpng)
pkg_check_modules(EPOXY REQUIRED IMPORTED_TARGET epoxy)

include("${CMAKE_CURRENT_LIST_DIR}/toeTargets.cmake")

# Back-compat alias: consumers that still say toe::core get the engine target.
if(TARGET toe::toe AND NOT TARGET toe::core)
  add_library(toe::core ALIAS toe::toe)
endif()

if(TARGET toe::toe)
  set(toe_toe_FOUND TRUE)
else()
  set(toe_toe_FOUND FALSE)
endif()

check_required_components(toe)
