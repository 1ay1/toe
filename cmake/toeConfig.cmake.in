@PACKAGE_INIT@
# SPDX-License-Identifier: LGPL-2.0-or-later
#
# toeConfig.cmake — find_package(toe) entry point.
#
# toe exports a single target: toe::toe — the terminal library (VT parse, screen
# model, scrollback, shell integration, key encoding). It has NO dependencies
# at all: no window system, no GPU, no fonts, no image codec. So there is
# nothing to find_dependency() here. toe::core is a back-compat alias.

include("${CMAKE_CURRENT_LIST_DIR}/toeTargets.cmake")

# Back-compat alias: consumers that still say toe::core get the same target.
if(TARGET toe::toe AND NOT TARGET toe::core)
  add_library(toe::core ALIAS toe::toe)
endif()

if(TARGET toe::toe)
  set(toe_toe_FOUND TRUE)
else()
  set(toe_toe_FOUND FALSE)
endif()

check_required_components(toe)
